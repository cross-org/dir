{
    "name": "@cross/dir",
    "version": "1.2.0",
    "exports": "./mod.ts",

    "tasks": {
        "check": "deno fmt --check && deno lint && deno check mod.ts && deno task test && deno task check-deps --slim",
        "check-deps": "deno run -A jsr:@check/deps --allow-unused",
        "test": "deno test -A",
        "publish-dry": "deno publish --dry-run"
    },
    "publish": {
        "exclude": [".github", "**/*.test.ts"]
    },
    "lock": true,
    "fmt": {
        "lineWidth": 120,
        "indentWidth": 4
    },
    "imports": {
        "@cross/env": "jsr:@cross/env@^1.0.0",
        "@cross/runtime": "jsr:@cross/runtime@^1.0.0",
        "@cross/test": "jsr:@cross/test@^0.0.14",
        "@cross/utils": "jsr:@cross/utils@^0.16.0",
        "@std/assert": "jsr:@std/assert@^1.0.19"
    }
}
